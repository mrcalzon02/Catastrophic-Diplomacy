{
  "schema": "cd.weapon-firing-range.v1",
  "purpose": "Deterministic fixed-platform visual acceptance; not evidence of captured video or device testing",
  "configuration": {
    "world": {
      "width": 1280,
      "height": 720,
      "camera": "fixed_top_down",
      "launcherX": 165,
      "laneY": [
        530,
        360,
        190
      ],
      "targetOrientation": "toward_launcher",
      "targetMode": "indestructible_diagnostic_plate"
    },
    "simulation": {
      "tickRateHz": 30,
      "seed": 2479,
      "disableHullTranslation": true,
      "disableAutonomousSteering": true,
      "disableTargetDestruction": true
    },
    "capture": {
      "width": 1920,
      "height": 1080,
      "fps": 60,
      "codec": "h264",
      "container": "mp4",
      "pixelFormat": "yuv420p",
      "frameSource": "offscreen_render_not_os_screen_recording",
      "frameStep": "deterministic_30hz_sim_with_60hz_render",
      "captureRawFrames": true,
      "expectedFramesPer24Seconds": 1440
    },
    "timing": {
      "preRollSeconds": 2,
      "singleFirePerLaneSeconds": 2,
      "simultaneousSeconds": 5,
      "staggeredSeconds": 6,
      "cleanupSeconds": 5,
      "sequenceForThreeWeaponsSeconds": 24,
      "additionalTailRule": "Keep recording until last live missile/drone/impact/decay completes, capped at 30s; failure if still alive after cap"
    },
    "review": {
      "requireEveryWeaponVisible": true,
      "requireFullCycleSlowInspection": true,
      "requireCleanImpactAndCleanup": true,
      "forbidPhysicalEmitterInEffectAtlas": true,
      "requireExplicitReviewerPass": true,
      "allowBatchToAdvanceWithRecordedFailures": true
    }
  },
  "batches": [
    {
